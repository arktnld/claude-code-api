# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
API_KEYS=key1,key2

# === Claude CLI / SDK ===
# ANTHROPIC_API_KEY=sk-ant-...          # Optional — leave empty to use CLI login (Max/Pro plan)
# CLAUDE_CLI_PATH=/usr/local/bin/claude
# CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TURNS=25
CLAUDE_TIMEOUT_SECONDS=300
# CLAUDE_SYSTEM_PROMPT=You are a helpful coding assistant.
# CLAUDE_PERMISSION_MODE=default        # default, plan, bypassPermissions
# CLAUDE_EFFORT=high                    # low, medium, high, max

# === Tools ===
CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep,LS,MultiEdit,NotebookRead,NotebookEdit,WebFetch,WebSearch
# CLAUDE_DISALLOWED_TOOLS=

# === Sandbox ===
SANDBOX_ENABLED=true
SANDBOX_EXCLUDED_COMMANDS=git,npm,pip,poetry,make,docker

# === Budget ===
CLAUDE_MAX_COST_PER_REQUEST=5.0
CLAUDE_MAX_COST_PER_USER=50.0

# === Retry ===
CLAUDE_RETRY_MAX_ATTEMPTS=2
CLAUDE_RETRY_BASE_DELAY=1.0
CLAUDE_RETRY_BACKOFF_FACTOR=2.0
CLAUDE_RETRY_MAX_DELAY=10.0

# === Sessions ===
APPROVED_DIRECTORY=/home/user/projects
DATABASE_URL=sqlite+aiosqlite:///data/sessions.db
SESSION_TIMEOUT_HOURS=24
MAX_SESSIONS_PER_USER=10

# === Security ===
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
CORS_ORIGINS=*

# === Server ===
ENABLE_DOCS=true
LOG_LEVEL=INFO
